# ============================================================
# LLM Configuration
# ============================================================
# OpenAI-compatible API base URL (e.g., https://api.openai.com/v1)
OPENAI_API_BASE=
# OpenAI-compatible API key
OPENAI_API_KEY=
# LLM model name
LLM_MODEL=
# Embedding model name
EMBEDDING_MODEL=

# ============================================================
# Path Configuration
# ============================================================
# Data collection write path (collected data + anomaly detection results)
COLLECTED_DATA_PATH=./data/collected_data/demo
# Data read path (read metric raw data when collect_data=False)
DATA_READ_PATH=./data/collected_data/demo
# Anomaly detection results read path (read detection results when run_anomaly_detection=False)
ANOMALY_DETECTION_READ_PATH=
# Analysis results write path (metric/causal/case analysis outputs)
ANALYSIS_RESULT_PATH=./result/demo
# Analysis results read path (read causal analysis results when run_causal_analysis=False)
ANALYSIS_READ_PATH=
# Metric analysis results read path (read metric analysis results when run_metric_analysis=False)
METRIC_ANALYSIS_READ_PATH=
# Data base path (root for all data directories)
DATA_BASE_PATH=./data
# ChromaDB vector database path
CHROMA_DB_PATH=./chroma_db/demo

# ============================================================
# Iteration Configuration
# ============================================================
# Maximum number of iterative refinement rounds
MAX_ITERATIONS=3
# Confidence threshold to stop iteration
ITERATION_THRESHOLD=0.8
